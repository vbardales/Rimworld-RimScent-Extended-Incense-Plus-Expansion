<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Memes etablis que les deux encens d'origine apres notre patch d'equilibrage : poste
       d'artisanat pour rester accessible a une colonie neolithique, laboratoire de drogues
       pour ceux qui l'ont. Pas de workSkill, comme en amont. -->

  <RecipeDef Abstract="True" Name="RimScentExtended_Recipe_AromaBase">
    <workAmount>1400</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_MakeBow</soundWorking>
    <researchPrerequisite>RimScentExtended_AromaticIncense</researchPrerequisite>
    <recipeUsers>
      <li>CraftingSpot</li>
      <li>DrugLab</li>
    </recipeUsers>
  </RecipeDef>

  <RecipeDef ParentName="RimScentExtended_Recipe_AromaBase">
    <defName>RimScentExtended_Make_Sandalwood</defName>
    <label>make sandalwood incense</label>
    <description>Press heartwood shavings with herbal resin into slow-burning sticks.</description>
    <jobString>Crafting sandalwood incense.</jobString>
    <ingredients>
      <li>
        <filter><thingDefs><li>WoodLog</li></thingDefs></filter>
        <count>8</count>
      </li>
      <li>
        <filter><thingDefs><li>MedicineHerbal</li></thingDefs></filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>WoodLog</li>
        <li>MedicineHerbal</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <RimScentExtended_Incense_Sandalwood>16</RimScentExtended_Incense_Sandalwood>
    </products>
  </RecipeDef>

